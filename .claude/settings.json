{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv sync --quiet --frozen --project \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODEGUARD=\"$CLAUDE_PROJECT_DIR/.venv/bin/codeguard\" uv run --quiet --script \"$CLAUDE_PROJECT_DIR/plugin/hooks/stop.py\" claude-code"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/checks.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODEGUARD=\"$CLAUDE_PROJECT_DIR/.venv/bin/codeguard\" uv run --quiet --script \"$CLAUDE_PROJECT_DIR/plugin/hooks/stop.py\" claude-code"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/checks.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet --frozen ruff format --quiet"
          }
        ]
      }
    ]
  }
}
